<%- |
  String[1] $compose_project,
  String[1] $compose_service,
  String[1] $compose_file,
  String[1] $token_file,
  String[1] $snapshot_path,
  String[1] $container_path,
| -%>
# Managed by Puppet - lsys::vault::backup. Do not edit on the host.
#
# Sourced by vault-snapshot and vault-snapshot-cleanup. Holds no secret: it
# names the token file, it does not contain the token.
COMPOSE_PROJECT=<%= $compose_project %>
COMPOSE_SERVICE=<%= $compose_service %>
COMPOSE_FILE=<%= $compose_file %>
TOKEN_FILE=<%= $token_file %>
SNAPSHOT_PATH=<%= $snapshot_path %>
CONTAINER_PATH=<%= $container_path %>
